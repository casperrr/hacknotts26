# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
*.png,[[:space:]]*.fbx,[[:space:]]*.glb,[[:space:]]*.jpg,[[:space:]]*.wav filter=lfs diff=lfs merge=lfs -text
